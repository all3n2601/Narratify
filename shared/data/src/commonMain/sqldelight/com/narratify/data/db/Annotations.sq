CREATE TABLE bookmark (
  id TEXT NOT NULL PRIMARY KEY,
  publication_id TEXT NOT NULL,
  locator_id TEXT NOT NULL,
  label TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  deleted_at INTEGER,
  schema_version INTEGER NOT NULL DEFAULT 1,
  FOREIGN KEY (publication_id) REFERENCES publication(id) ON DELETE CASCADE,
  FOREIGN KEY (locator_id) REFERENCES publication_locator(id) ON DELETE RESTRICT
);

CREATE INDEX bookmark_publication_idx
ON bookmark(publication_id, created_at DESC);

selectBookmarks:
SELECT bookmark.*, publication_locator.resource_id,
       publication_locator.resource_progression,
       publication_locator.total_progression,
       publication_locator.text_exact
FROM bookmark
JOIN publication_locator ON publication_locator.id = bookmark.locator_id
WHERE bookmark.publication_id = ? AND bookmark.deleted_at IS NULL
ORDER BY bookmark.created_at DESC;

insertBookmark:
INSERT INTO bookmark(
  id, publication_id, locator_id, label, created_at, updated_at,
  deleted_at, schema_version
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

softDeleteBookmark:
UPDATE bookmark SET deleted_at = ?, updated_at = ? WHERE id = ?;

CREATE TABLE highlight (
  id TEXT NOT NULL PRIMARY KEY,
  publication_id TEXT NOT NULL,
  start_locator_id TEXT NOT NULL,
  end_locator_id TEXT NOT NULL,
  selected_text TEXT,
  note TEXT,
  color TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  deleted_at INTEGER,
  schema_version INTEGER NOT NULL DEFAULT 1,
  FOREIGN KEY (publication_id) REFERENCES publication(id) ON DELETE CASCADE,
  FOREIGN KEY (start_locator_id) REFERENCES publication_locator(id) ON DELETE RESTRICT,
  FOREIGN KEY (end_locator_id) REFERENCES publication_locator(id) ON DELETE RESTRICT
);

CREATE INDEX highlight_publication_idx
ON highlight(publication_id, created_at DESC);

selectHighlights:
SELECT * FROM highlight
WHERE publication_id = ? AND deleted_at IS NULL
ORDER BY created_at;

insertHighlight:
INSERT INTO highlight(
  id, publication_id, start_locator_id, end_locator_id, selected_text,
  note, color, created_at, updated_at, deleted_at, schema_version
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateHighlightNote:
UPDATE highlight SET note = ?, color = ?, updated_at = ? WHERE id = ?;

softDeleteHighlight:
UPDATE highlight SET deleted_at = ?, updated_at = ? WHERE id = ?;

