CREATE TABLE library_file (
  id TEXT NOT NULL PRIMARY KEY,
  publication_id TEXT NOT NULL,
  role TEXT NOT NULL,
  storage_uri TEXT NOT NULL,
  display_name TEXT,
  media_type TEXT,
  content_hash TEXT NOT NULL,
  byte_size INTEGER NOT NULL,
  source_modified_at INTEGER,
  is_linked INTEGER NOT NULL DEFAULT 0 CHECK (is_linked IN (0, 1)),
  resource_index INTEGER,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  FOREIGN KEY (publication_id) REFERENCES publication(id) ON DELETE CASCADE,
  UNIQUE(publication_id, role, storage_uri)
);

CREATE INDEX library_file_publication_idx
ON library_file(publication_id, role);

CREATE INDEX library_file_hash_idx
ON library_file(content_hash, byte_size);

selectFilesForPublication:
SELECT * FROM library_file
WHERE publication_id = ?
ORDER BY role, resource_index, created_at;

selectFilesByHash:
SELECT * FROM library_file
WHERE content_hash = ? AND byte_size = ?;

insertLibraryFile:
INSERT INTO library_file(
  id, publication_id, role, storage_uri, display_name, media_type,
  content_hash, byte_size, source_modified_at, is_linked, resource_index,
  created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteFilesForPublication:
DELETE FROM library_file WHERE publication_id = ?;

