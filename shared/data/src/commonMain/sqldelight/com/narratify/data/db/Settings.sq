CREATE TABLE setting (
  scope TEXT NOT NULL,
  publication_id TEXT NOT NULL DEFAULT '',
  key TEXT NOT NULL,
  value_json TEXT NOT NULL,
  value_version INTEGER NOT NULL DEFAULT 1,
  updated_at INTEGER NOT NULL,
  PRIMARY KEY (scope, publication_id, key),
  CHECK (
    (scope = 'global' AND publication_id = '') OR
    (scope = 'publication' AND publication_id <> '')
  )
);

selectGlobalSettings:
SELECT * FROM setting
WHERE scope = 'global' AND publication_id = ''
ORDER BY key;

selectPublicationSettings:
SELECT * FROM setting
WHERE scope = 'publication' AND publication_id = ?
ORDER BY key;

selectResolvedSetting:
SELECT * FROM setting
WHERE key = ?
  AND ((scope = 'publication' AND publication_id = ?)
       OR (scope = 'global' AND publication_id = ''))
ORDER BY CASE scope WHEN 'publication' THEN 0 ELSE 1 END
LIMIT 1;

upsertSetting:
INSERT OR REPLACE INTO setting(
  scope, publication_id, key, value_json, value_version, updated_at
) VALUES (?, ?, ?, ?, ?, ?);

deletePublicationSettings:
DELETE FROM setting WHERE scope = 'publication' AND publication_id = ?;
