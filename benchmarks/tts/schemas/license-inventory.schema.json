{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narratify.local/schemas/tts-license-inventory-v1.json",
  "title": "Narratify TTS distribution license inventory",
  "type": "object",
  "required": ["schema_version", "review_status", "reviewed_by", "reviewed_at_utc", "components"],
  "properties": {
    "schema_version": {"const": 1},
    "review_status": {"enum": ["pending", "approved-commercial", "rejected"]},
    "reviewed_by": {"type": ["string", "null"]},
    "reviewed_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["engine_variant", "component", "kind", "version_or_commit", "sha256", "source_url", "license_expression", "license_evidence_url", "redistributed", "commercial_conclusion", "notes"],
        "properties": {
          "engine_variant": {"type": "string"},
          "component": {"type": "string"},
          "kind": {"enum": ["code", "runtime", "model", "voice", "phonemizer", "lexicon", "data", "audio"]},
          "version_or_commit": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "source_url": {"type": "string"},
          "license_expression": {"type": ["string", "null"]},
          "license_evidence_url": {"type": ["string", "null"]},
          "redistributed": {"type": "boolean"},
          "commercial_conclusion": {"enum": ["pending", "approved", "rejected"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
